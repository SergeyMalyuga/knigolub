generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Book {
  id          String   @id @default(uuid())
  googleId    String?  @unique // ID книги из Google Books API
  title       String
  authors     Json // Массив авторов
  description String?  // Описание/аннотация
  thumbnail   String?  // Ссылка на обложку
  isbn10      String?  @unique
  isbn13      String?  @unique
  publisher   String?
  publishedAt DateTime?
  pageCount   Int?
  language    String?  @default("ru")
  categories  Json // Жанры/категории
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
}
